# Template only. Never commit actual credentials.
# pnpm dev loads .env; model keys are passed only to the Worker.
# The handshake probe does not load .env or send a model request.
SOUNDLAB_MODEL_ROUTE=minimax
MINIMAX_API_KEY=
DEEPSEEK_API_KEY=
# Enable only after authorizing ongoing demo event analysis via the selected provider.
SOUNDLAB_MODEL_ANALYSIS=false
# Explicit user-initiated chat, independent from automatic order analysis.
SOUNDLAB_CHAT_ENABLED=false
# Queue check interval (1000..3600000 ms). No events means no model call.
SOUNDLAB_ANALYSIS_INTERVAL_MS=5000
# Optional selected-route overrides. HTTPS endpoint only; no credentials/query/fragment.
# SOUNDLAB_MODEL_ID=MiniMax-M3
# SOUNDLAB_MODEL_BASE_URL=https://api.minimax.cn/v1
# Each timeout is 1000..600000 ms; run must cover initialize + request.
SOUNDLAB_MODEL_INITIALIZE_TIMEOUT_MS=30000
SOUNDLAB_MODEL_REQUEST_TIMEOUT_MS=60000
SOUNDLAB_MODEL_RUN_TIMEOUT_MS=90000

# Dev defaults to demo identities; start defaults to session login.
# SOUNDLAB_DEMO_MODE=false
# SOUNDLAB_APP_ORIGIN=http://127.0.0.1:5179
# SOUNDLAB_WEB_HOST=127.0.0.1
# Generic inbound bridge only; vendor integration and identity mapping required.
# SOUNDLAB_CHANNEL_SECRET=

# WeCom self-built app. Values stay server-side; never use VITE_ names.
WECOM_CORP_ID=
WECOM_AGENT_ID=
WECOM_CALLBACK_TOKEN=
WECOM_ENCODING_AES_KEY=
WECOM_APP_SECRET=
# Explicitly enable only after reviewing recipients and authorizing notifications.
WECOM_SEND_ENABLED=false
# Production DB initialization can omit demo seed.
# SOUNDLAB_SEED_DEMO=false
